# LogEarn Growth Analytics - Frontend Configuration
# Copy this file to .env.local and configure your data source

# Option 1: Use backend aggregation API (recommended for production)
VITE_BACKEND_BASE_URL=http://localhost:3001

# Option 2: Direct API connection (for development/testing only)
# VITE_ANALYTICS_DATA_SOURCE=api
# VITE_ANALYTICS_API_BASE_URL=/api/analytics

# Note: At least one data source must be configured.
# Mock JSON data mode has been removed as of October 2026.
