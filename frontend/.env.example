# Operator backend (auth / cohorts / saved configs / analytics).
# When set, the dashboard authenticates against this origin.
# Large SQLite datasets bootstrap via GET /api/analytics/meta and use
# /api/metrics/* + /api/drill/* (aggregated mode). Small datasets may still
# download raw facts once; oversized dumps return HTTP 413.
VITE_BACKEND_BASE_URL=http://localhost:3001

# Legacy external analytics API mode (used only when BACKEND_BASE_URL is unset):
#   mock = local JSON fixtures
#   api  = fetch from VITE_ANALYTICS_API_BASE_URL
VITE_ANALYTICS_DATA_SOURCE=mock
VITE_ANALYTICS_API_BASE_URL=/api/analytics
