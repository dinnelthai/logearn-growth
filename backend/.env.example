# Database
DATABASE_URL=postgresql://user:password@localhost:5432/logearn_growth

# Hologres (数据仓库)
HOLOGRES_HOST=
HOLOGRES_PORT=80
HOLOGRES_DATABASE=
HOLOGRES_USER=
HOLOGRES_PASSWORD=

# Auth
JWT_SECRET=your-secret-key-here
SESSION_SECRET=another-secret-key

# Server
PORT=3000
NODE_ENV=development

# AI / LLM 配置


# User-supplied DeRouter screen quote on 2026-10-28: GPT-6.1 Terra
# $0.0665 input / $0.3325 output PER MILLION tokens.
# Backend expects USD PER 1,000 tokens, hence the division by 1000.
# These are estimates until confirmed against actual relay billing.
AI_RELAY_COST_PER_1K_INPUT=0.0000665
AI_RELAY_COST_PER_1K_OUTPUT=0.0003325
# Only for independently verified free models, opt into 0/0 with:
# AI_RELAY_FREE_TIER_VERIFIED=1
# Maximum per-owner daily token budget (independent of USD budget)
AI_MAX_DAILY_TOKENS=100000
# Optional daily preflight: only suppress paid core-goal jobs with verified
# mature metrics and no qualifying signals. Unverified metrics defer, never certify success.
# AI_AUTONOMY_SIGNAL_GATE_ENABLED=1

# AI 通用配置
AI_TIMEOUT=60000
AI_RETRY_ATTEMPTS=3
AI_RETRY_DELAY=1000

# 成本控制
AI_MAX_DAILY_COST=0.10
AI_COST_ALERT_THRESHOLD=0.05

# 速率限制
AI_RATE_LIMIT_PER_HOUR=100

# 日志和监控
AI_LOG_LEVEL=info
AI_ENABLE_METRICS=true

# Redis 缓存配置
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# RAG 向量检索配置
# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=logearn_knowledge
REDIS_DB=0
REDIS_KEY_PREFIX=logearn:
REDIS_CONNECT_TIMEOUT=5000

# 缓存配置
CACHE_LLM_TTL=86400
CACHE_DATA_TTL=3600

# Bull 队列配置
AI_WORKER_CONCURRENCY=5
TZ=Asia/Shanghai

# WebSocket 配置
WS_PORT=3000
WS_CORS_ORIGIN=http://localhost:5173,http://localhost:5174
WS_PING_INTERVAL=25000
WS_PING_TIMEOUT=20000

# Twitter API (用于 X Acquisition)
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# 内容渠道增长：官方 X API 只读采集复用 TWITTER_BEARER_TOKEN；无需账号 OAuth。
AI_TASK_MAX_CALLS=6
AI_TASK_MAX_TOKENS=50000
AI_TASK_MAX_OUTPUT_TOKENS=4096
AI_TASK_MAX_INPUT_BYTES=240000
AI_TASK_TIMEOUT_MS=600000
AI_WEBSOCKET_ENABLED=false

# Optional standard PostgreSQL for AI records (required if PGHOST is an incompatible analytics engine).
AI_DATABASE_URL=

# DeRouter：只使用一个模型；在下面填写密钥后重启后端和 AI worker。
AI_DEFAULT_MODEL=gpt-6.1-terra
OPENAI_BASE_URL=https://api.derouter.network/openai/v1
OPENAI_API_KEY=

# Growth AI autonomous daily analysis: opt-in and hard per-owner Bangkok-day call reservations
# AI_AUTONOMY_ENABLED=1
# AI_AUTONOMY_OWNER_IDS=<explicit owner ID>
# AI_AUTONOMY_PAID_DAILY_ENABLED=1
# AI_AUTONOMY_PAID_CALLS_PER_DAY=12
# AI_RESEARCH_DISCOVERY_ENABLED=1  # Read-only research questions from recorded business changes

# Prompt candidates may be proposed and evaluated without activating them.
# AI_PROMPT_AUTO_PUBLISH=1  # Operator-approved candidate activation in registry, not LLM authorization
# AI_PROMPT_RUNTIME_ENABLED=1  # Keep OFF until prompt replay and canary tests are green

# AI observed-feedback prompt proposals: produces only staged candidates, no paid calls or publication.
# AI_PROMPT_CANDIDATE_PROPOSAL_ENABLED=1

# Optional immutable Hologres snapshot + aggregate-only weekly-core Redis L2 cache.
# Never store weekly-core user_key membership lists in shared Redis.
# Require a UNIQUE namespace for each environment/database/event source.
# Default disabled; live status and owner/LLM data remain uncached in L2.
# GROWTH_SHARED_CACHE_URL=redis://127.0.0.1:6379/0
# GROWTH_SHARED_CACHE_NAMESPACE=prod_growth_events_v1

# Hologres 4-scan versus combined status SQL: experimental until real EXPLAIN + parity approval.
# HOLOGRES_STATUS_COMPACT_ENABLED=1
# Read-only plan diagnostics (never enables ANALYZE automatically).
# HOLOGRES_EXPLAIN_APPROVED=1
# HOLOGRES_EXPLAIN_EXPECTED_DB=<read-only target database name>
# HOLOGRES_EXPLAIN_ANALYZE_APPROVED=1   # only for explicit, potentially heavy execution
