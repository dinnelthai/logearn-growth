# LogEarn Growth Analytics - Backend Configuration
# Copy this file to .env and configure your data sources

# Database Configuration
# SQLite database path (for local development)
DB_PATH=./data/analytics.db

# Hologres Configuration (for production/remote analytics)
HOLOGRES_HOST=your-hologres-instance.hologres.aliyuncs.com
HOLOGRES_PORT=80
HOLOGRES_DATABASE=your_database
HOLOGRES_USER=your_username
HOLOGRES_PASSWORD=your_password

# Hologres Connection Pool Optimization
PG_POOL_MAX=10                    # 最大连接数 (默认: 4)
PG_CONNECT_TIMEOUT_MS=3000        # 连接超时 (默认: 5000ms)
PG_IDLE_TIMEOUT_MS=30000          # 空闲连接超时 (默认: 30s)
PG_STATEMENT_TIMEOUT_MS=15000     # 语句超时 (默认: 10s)

# API Configuration
PORT=3001
JWT_SECRET=your-jwt-secret-change-in-production

# Operations Token (for administrative endpoints)
OPS_TOKEN=your-secure-operations-token

# Cache Configuration (阶段 1 优化)
CACHE_TTL_SECONDS=30              # L1 缓存 TTL (默认: 30s)
CACHE_MAX_KEYS=500                # L1 缓存最大 key 数 (默认: 500)
CACHE_SWR_ENABLED=true            # 启用 Stale-While-Revalidate (默认: true)

# Redis L2 Cache (阶段 2 优化 - 可选)
ENABLE_REDIS_L2=false             # 启用 Redis L2 缓存 (默认: false)
REDIS_HOST=localhost              # Redis 主机
REDIS_PORT=6379                   # Redis 端口
REDIS_PASSWORD=                   # Redis 密码 (可选)
REDIS_DB=0                        # Redis 数据库编号 (默认: 0)

# Materialized Views (阶段 2 优化)
ENABLE_MATERIALIZED_VIEWS=false   # 启用物化视图 (默认: false)
MV_REFRESH_SCHEDULE=5 * * * *     # Cron 表达式: 每小时第 5 分钟刷新

# Daily Rollups (阶段 2 优化)
ENABLE_DAILY_ROLLUP=true          # 启用每日预聚合 (默认: true)
ROLLUP_SCHEDULE=5 2 * * *         # Cron 表达式: 每日凌晨 2:05 刷新

# Read/Write Split (阶段 2 优化 - 需要只读副本)
ENABLE_READ_REPLICA=false         # 启用读写分离 (默认: false)
PGHOST_REPLICA=                   # 只读副本地址 (可选)
PGPORT_REPLICA=5432               # 只读副本端口 (默认: 5432)
PGDATABASE_REPLICA=               # 只读副本数据库 (默认: 同主库)
PGUSER_REPLICA=                   # 只读副本用户 (默认: 同主库)
PGPASSWORD_REPLICA=               # 只读副本密码 (默认: 同主库)

# Note: Mock data mode has been removed as of October 2026.
# All data must now come from SQLite or Hologres.
