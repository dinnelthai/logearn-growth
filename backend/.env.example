# Database
DATABASE_URL=postgresql://user:password@localhost:5432/logearn_growth

# Hologres (数据仓库)
HOLOGRES_HOST=
HOLOGRES_PORT=80
HOLOGRES_DATABASE=
HOLOGRES_USER=
HOLOGRES_PASSWORD=

# Auth
JWT_SECRET=your-secret-key-here
SESSION_SECRET=another-secret-key

# Server
PORT=3000
NODE_ENV=development

# AI / LLM 配置
# 默认使用的模型 (gpt-4o-mini, gpt-4o, claude-sonnet-4, claude-opus-4 等)
AI_DEFAULT_MODEL=gpt-4o-mini

# OpenAI (ChatGPT)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com

# AI 通用配置
AI_TIMEOUT=60000
AI_RETRY_ATTEMPTS=3
AI_RETRY_DELAY=1000

# 成本控制
AI_MAX_DAILY_COST=5.0
AI_COST_ALERT_THRESHOLD=3.0

# 日志和监控
AI_LOG_LEVEL=info
AI_ENABLE_METRICS=true

# Twitter API (用于 X Acquisition)
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
