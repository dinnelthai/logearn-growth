# Database
DATABASE_URL=postgresql://user:password@localhost:5432/logearn_growth

# Hologres (数据仓库)
HOLOGRES_HOST=
HOLOGRES_PORT=80
HOLOGRES_DATABASE=
HOLOGRES_USER=
HOLOGRES_PASSWORD=

# Auth
JWT_SECRET=your-secret-key-here
SESSION_SECRET=another-secret-key

# Server
PORT=3000
NODE_ENV=development

# AI / LLM 配置


# USD per 1,000 tokens; zero means unconfigured, not free usage.
AI_RELAY_COST_PER_1K_INPUT=0
AI_RELAY_COST_PER_1K_OUTPUT=0

# AI 通用配置
AI_TIMEOUT=60000
AI_RETRY_ATTEMPTS=3
AI_RETRY_DELAY=1000

# 成本控制
AI_MAX_DAILY_COST=5.0
AI_COST_ALERT_THRESHOLD=3.0

# 速率限制
AI_RATE_LIMIT_PER_HOUR=100

# 日志和监控
AI_LOG_LEVEL=info
AI_ENABLE_METRICS=true

# Redis 缓存配置
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# RAG 向量检索配置
# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=logearn_knowledge
REDIS_DB=0
REDIS_KEY_PREFIX=logearn:
REDIS_CONNECT_TIMEOUT=5000

# 缓存配置
CACHE_LLM_TTL=86400
CACHE_DATA_TTL=3600

# Bull 队列配置
AI_WORKER_CONCURRENCY=5
TZ=Asia/Shanghai

# WebSocket 配置
WS_PORT=3000
WS_CORS_ORIGIN=http://localhost:5173,http://localhost:5174
WS_PING_INTERVAL=25000
WS_PING_TIMEOUT=20000

# Twitter API (用于 X Acquisition)
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=

AI_TASK_MAX_CALLS=6
AI_TASK_MAX_TOKENS=50000
AI_TASK_MAX_OUTPUT_TOKENS=4096
AI_TASK_MAX_INPUT_BYTES=240000
AI_TASK_TIMEOUT_MS=600000
AI_WEBSOCKET_ENABLED=false

# Optional standard PostgreSQL for AI records (required if PGHOST is an incompatible analytics engine).
AI_DATABASE_URL=

# DeRouter：只使用一个模型；在下面填写密钥后重启后端和 AI worker。
AI_DEFAULT_MODEL=claude-sonnet-4-6
OPENAI_BASE_URL=https://api.derouter.network/openai/v1
OPENAI_API_KEY=

# Growth AI autonomous daily analysis: opt-in and hard per-owner Bangkok-day call reservations
# AI_AUTONOMY_ENABLED=1
# AI_AUTONOMY_OWNER_IDS=<explicit owner ID>
# AI_AUTONOMY_PAID_DAILY_ENABLED=1
# AI_AUTONOMY_PAID_CALLS_PER_DAY=12
# AI_RESEARCH_DISCOVERY_ENABLED=1  # Read-only research questions from recorded business changes
