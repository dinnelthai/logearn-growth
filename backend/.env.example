# Runtime configuration. Copy to backend/.env and supply real values.
# Local SQLite keeps app accounts, sessions and operational records in either mode.
DB_PATH=./data/analytics.db
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Use the existing remote event/business tables for analytics.
ANALYTICS_STORAGE=hologres
PGHOST=your-hologres-host
PGPORT=80
PGDATABASE=your_database
PGUSER=your_username
PGPASSWORD=your_password
# Alternatively use DATABASE_URL instead of PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD.
# DATABASE_URL=postgresql://user:password@host:port/database
# prefer retries without TLS only if the server explicitly does not support TLS.
PGSSL=prefer
SOURCE_EVENTS_TABLE=growth_events
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=3000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=15000

# Initial operator account: created only if the local users table is empty.
ADMIN_EMAIL=admin@logearn.com
ADMIN_NAME=Admin
# Set a strong password before first startup; omitted means a generated password.
# ADMIN_PASSWORD=

# OPS credentials are entered per operator through the UI, not as analytics auth.
# Optional stable encryption key: 64 hexadecimal characters. Keep it secret and backed up.
# OPS_TOKEN_ENCRYPTION_KEY=

# Optional wallet-asset collection. Configure only the chains actually in use.
# ASSET_RPC_BSC=
# ASSET_RPC_SOLANA=
# ASSET_RPC_ARC=
# ASSET_RPC_ROBINHOOD=

# Cache limits are enforced in src/cache/multilevel.js, not environment variables.
# Legacy Redis L2/SWR, daily rollup and materialized-view scheduling flags remain inactive.
# Versioned local path facts and session index. Source database stays read-only.
ENABLE_PATH_INDEX=true
# Optional dedicated file; relative paths resolve from backend/. Do not share across data sources.
# PATH_INDEX_DB=./data/path-index.db
# Refreshes every 60s; stale after 90s -> original remote query at the same snapshot.
# Run the read-only database audit: npm run audit:tracking -- --days 7

# X keyword acquisition. Secret stays on the backend; never use VITE_ for this key.
TWITTERAPI_IO_API_KEY=
# Shared daily collector budget in USD, measured by UTC+7 day (estimated at $0.15/1k tweets).
# Automatic monitoring is switched on per operator inside Growth, initially paused.
# 默认 $1/天（约 3-4 次搜索）；建议扩展期设为 $5-10/天（16-33 次搜索）
X_ACQUISITION_DAILY_USD=1
# Temporary local development only. Accept any nonempty login inputs on loopback.
# Production ignores this flag; disabling it also invalidates development sessions.
LOCAL_DEV_LOGIN=false
