{
  "name": "logearn-analytics-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/db/migrate.js",
    "migrate:ai": "node src/db/migrateAI.js",
    "generate:data": "node src/db/generateBusinessData.js",
    "generate:data:2m": "USERS=50000 TARGET_EVENTS=2000000 BATCH=200 node src/db/generateBusinessData.js",
    "rebuild:rollups": "node src/db/rebuildRollups.js",
    "import:events": "node src/db/importGrowthEvents.js",
    "import:events:full": "node src/db/importGrowthEvents.js --import --rebuild",
    "test": "node --test test/*.test.js",
    "test:cache": "node test/test-cache.js",
    "test:queue": "node test/test-queue.js",
    "test:websocket": "node test/test-websocket.js",
    "test:llm": "node src/ai/llm/test.js",
    "test:rag": "node test/test-rag.js",
    "test:ai-data": "node test/test-ai-data-integration.js",
    "start:remote": "ANALYTICS_STORAGE=hologres node src/index.js",
    "audit:tracking": "node ../scripts/audit-tracking.cjs",
    "path-index:refresh": "node src/pathIndex/cli.js",
    "worker:ai": "node src/queues/workers/aiAnalysisWorker.js",
    "worker:growth-daily": "node src/queues/workers/dailyGrowthScheduler.js",
    "scheduler": "node -e \"console.error('AI tasks are manual only; scheduler disabled'); process.exit(1)\"",
    "queue:dev": "npm run dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@qdrant/js-client-rest": "^1.20.0",
    "bull": "^4.16.5",
    "bullmq": "^6.4.2",
    "cors": "2.8.5",
    "dotenv": "^18.0.6",
    "express": "4.19.2",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "openai": "^4.77.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "uuid": "^11.1.1"
  },
  "optionalDependencies": {
    "ioredis": "^5.11.1"
  }
}
